{
    /*
     * RefArchGlobal is the multi-locale example
     * Every example hostname is commented so generated sites cannot collide
     *
     * The alias parser accepts comments, trailing commas, and legacy equal signs
     * Site import and export preserve the source byte-for-byte
     * Site import can store invalid syntax or an unsupported version while runtime ignores it
     * Business Manager rejects those invalid files at save time
     */
    "__version": "1",

    "settings": {
        /*
         * Choose one of the two settings ownership patterns below
         * job-hostnames can accompany either pattern
         */

        /*
         * Settings-owned hostname
         *
         * http-host and https-host participate in inbound site ownership
         * A settings match is evaluated before top-level hostname rules
         * Do not mix settings ownership with top-level ownership on another site
         */
        /*
        "http-host": "settings-global.example.com",
        "https-host": "settings-global.example.com",
        */

        /*
         * Settings-based shared hostname path
         *
         * The root site must use the same hosts with default set to true
         * This site then owns one path and serves its site default locale there
         * Use top-level if-site-path rules instead when each path needs its own locale
         */
        /*
        "http-host": "settings-shared.example.com",
        "https-host": "settings-shared.example.com",
        "site-path": "global",
        */

        /*
         * Locale-specific job hostname selection
         *
         * https-host wins first when it is configured
         * Otherwise lookup is exact locale, language, then default
         * Every value must also have a top-level mapping to this site
         * An unmapped value is skipped and generation falls through to the instance .my domain
         */
        /*
        "job-hostnames": {
            "default": "gb.example.com",
            "fr": "fr.example.com",
            "it": "it.example.com",
            "ja": "jp.example.com",
            "zh": "cn.example.com"
        }
        */
    },

    /*
     * Locale paths on a top-level hostname whose root belongs to RefArch
     *
     * Neither site can claim this hostname through settings
     * RefArch owns / while this site owns /gb/, /fr/, /it/, /jp/, and /cn/
     * The entry-point rule keeps canonical homes beneath each site path
     * Do not add a root rule here because duplicate roots compete rather than fall back
     */
    /*
    "www.example.com": [
        {
            "if-site-path": "gb",
            "locale": "en_GB",
            "site-path-trailing-slash": "yes"
        },
        {
            "if-site-path": "fr",
            "locale": "fr_FR",
            "site-path-trailing-slash": "yes"
        },
        {
            "if-site-path": "it",
            "locale": "it_IT",
            "site-path-trailing-slash": "yes"
        },
        {
            "if-site-path": "jp",
            "locale": "ja_JP",
            "site-path-trailing-slash": "yes"
        },
        {
            "if-site-path": "cn",
            "locale": "zh_CN",
            "site-path-trailing-slash": "yes"
        },
        {
            "entry-point-pipelines": ["Default-Start", "Home-Show"],
            "entry-point-destination": ["site-path"]
        }
    ],
    */

    /*
     * One international hostname owned entirely by RefArchGlobal
     *
     * Conditional path rules must precede the unconditional root rule
     * site-path must precede host so non-default locales keep their paths
     * The en_GB root is the fallback representation when no locale path applies
     */
    /*
    "global.example.com": [
        {
            "if-site-path": "fr",
            "locale": "fr_FR",
            "site-path-trailing-slash": "yes"
        },
        {
            "if-site-path": "it",
            "locale": "it_IT",
            "site-path-trailing-slash": "yes"
        },
        {
            "if-site-path": "jp",
            "locale": "ja_JP",
            "site-path-trailing-slash": "yes"
        },
        {
            "if-site-path": "cn",
            "locale": "zh_CN",
            "site-path-trailing-slash": "yes"
        },
        {
            "locale": "en_GB",
            "apply-to-host-only-request-with-params": true
        },
        {
            "entry-point-pipelines": ["Default-Start", "Home-Show"],
            "entry-point-destination": ["site-path", "host"]
        }
    ],
    */

    /*
     * Locale-specific domains and job-hostname mappings
     *
     * Each hostname owns its root and fixes the locale for inbound requests
     * The same mappings make the job-hostnames values applicable
     */
    /*
    "gb.example.com": [
        {
            "locale": "en_GB",
            "apply-to-host-only-request-with-params": true
        },
        {
            "entry-point-pipelines": ["Default-Start", "Home-Show"],
            "entry-point-destination": ["host"]
        }
    ],
    "fr.example.com": [
        {
            "locale": "fr_FR",
            "apply-to-host-only-request-with-params": true
        },
        {
            "entry-point-pipelines": ["Default-Start", "Home-Show"],
            "entry-point-destination": ["host"]
        }
    ],
    "it.example.com": [
        {
            "locale": "it_IT",
            "apply-to-host-only-request-with-params": true
        },
        {
            "entry-point-pipelines": ["Default-Start", "Home-Show"],
            "entry-point-destination": ["host"]
        }
    ],
    "jp.example.com": [
        {
            "locale": "ja_JP",
            "apply-to-host-only-request-with-params": true
        },
        {
            "entry-point-pipelines": ["Default-Start", "Home-Show"],
            "entry-point-destination": ["host"]
        }
    ],
    "cn.example.com": [
        {
            "locale": "zh_CN",
            "apply-to-host-only-request-with-params": true
        },
        {
            "entry-point-pipelines": ["Default-Start", "Home-Show"],
            "entry-point-destination": ["host"]
        }
    ],
    */

    /*
     * Alternate, legacy, or misspelled hostname redirect
     *
     * The host-only root redirects permanently to the configured host and path
     * The apply flag preserves an incoming query string
     * Deeper requests do not use this alias redirect and continue on the incoming host
     * Use URL Redirects when legacy deep paths must move to another hostname
     */
    /*
    "global-example.com": [
        {
            "host": "global.example.com",
            "path": "/",
            "apply-to-host-only-request-with-params": true
        }
    ],
    */

    /*
     * Host-only content landing page with pipeline parameters
     *
     * The root runs Page-Show with the configured content asset
     * Query-bearing root requests need the apply flag
     * Normal paths continue through storefront URL routing
     * A configured pipeline parameter wins over the same incoming query parameter
     */
    /*
    "about.global.example.com": [
        {
            "locale": "en_GB",
            "pipeline": "Page-Show",
            "params": {
                "cid": "about-us"
            },
            "apply-to-host-only-request-with-params": true
        }
    ],
    */

    /*
     * Legacy user-agent redirect with multiple conditions and a fallback
     *
     * if-agent-contains matches User-Agent text case-insensitively
     * The first applicable rule wins
     * Each matching host action returns a permanent 301 response
     */
    /*
    "device.global.example.com": [
        {
            "if-agent-contains": ["iphone", "ipod", "android"],
            "host": "m.global.example.com"
        },
        {
            "if-agent-contains": ["blackberry"],
            "host": "legacy-mobile.global.example.com"
        },
        {
            "host": "global.example.com"
        }
    ],
    */

    /*
     * Retired locale domain redirected to a shared-host site path
     *
     * The host-only root redirects to /fr and preserves an incoming query string
     * Deeper requests do not use this alias redirect or inherit /fr
     * Use URL Redirects when deep legacy paths must remain below /fr
     */
    /*
    "old-example.fr": [
        {
            "host": "www.example.com",
            "path": "/fr",
            "apply-to-host-only-request-with-params": true
        }
    ],
    */
}
