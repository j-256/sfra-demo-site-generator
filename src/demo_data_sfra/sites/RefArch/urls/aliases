{
    /*
     * RefArch is the single-locale example
     * Every example hostname is commented so generated sites cannot collide
     *
     * The alias parser accepts comments, trailing commas, and legacy equal signs
     * Site import and export preserve the source byte-for-byte
     * Site import can store invalid syntax or an unsupported version while runtime ignores it
     * Business Manager rejects those invalid files at save time
     */
    "__version": "1",

    "settings": {
        /*
         * Settings-owned hostname
         *
         * http-host and https-host participate in inbound site ownership
         * A settings match is evaluated before top-level hostname rules
         * URLUtils.https(pipeline) also prefers https-host over the request hostname
         * Do not add a top-level rule for this hostname on another site
         */
        /*
        "http-host": "settings.example.com",
        "https-host": "settings.example.com",
        */

        /*
         * Job hostname selection without a storefront request
         *
         * https-host wins first when it is configured
         * Otherwise lookup is exact locale, language, then default
         * Every value must also have a top-level mapping to this site
         * An unmapped value is skipped and generation falls through to the instance .my domain
         */
        /*
        "job-hostnames": {
            "default": "jobs.example.com",
            "en_US": "us-jobs.example.com"
        }
        */
    },

    /*
     * Canonical single-locale storefront using top-level ownership
     *
     * Do not also claim this hostname through settings
     * The root rule selects en_US without replacing Default-Start
     * The apply flag also handles host-only requests with query parameters
     * The entry-point rule collapses /home and /homepage to the hostname root
     */
    /*
    "www.example.com": [
        {
            "locale": "en_US",
            "apply-to-host-only-request-with-params": true
        },
        {
            "entry-point-pipelines": ["Default-Start", "Home-Show"],
            "entry-point-destination": ["host"]
        }
    ],
    */

    /*
     * Top-level mappings required by the job-hostnames example
     *
     * These mappings make the job values applicable
     * They also make the hostnames valid inbound roots for this site
     */
    /*
    "jobs.example.com": [
        {
            "locale": "en_US"
        }
    ],
    "us-jobs.example.com": [
        {
            "locale": "en_US"
        }
    ],
    */

    /*
     * Alternate, legacy, or misspelled hostname redirect
     *
     * The host-only root redirects permanently to the configured host and path
     * The apply flag preserves an incoming query string
     * Deeper requests do not use this alias redirect and continue on the incoming host
     * Use URL Redirects when legacy deep paths must move to another hostname
     */
    /*
    "example.com": [
        {
            "host": "www.example.com",
            "path": "/",
            "apply-to-host-only-request-with-params": true
        }
    ],
    */

    /*
     * Host-only campaign or vanity-domain landing page
     *
     * The hostname root runs Page-Show with the configured content asset
     * Query-bearing root requests need the apply flag
     * Normal paths such as /cart continue through storefront URL routing
     * A configured pipeline parameter wins over the same incoming query parameter
     */
    /*
    "about.example.com": [
        {
            "locale": "en_US",
            "pipeline": "Page-Show",
            "params": {
                "cid": "about-us"
            },
            "apply-to-host-only-request-with-params": true
        }
    ],
    */

    /*
     * Combined host and pipeline redirect
     *
     * Host chooses the destination hostname
     * The pipeline-generated URL chooses the destination path
     * Do not add path because pipeline supersedes it
     * An incoming query value wins over the same configured redirect parameter
     */
    /*
    "campaign.example.com": [
        {
            "host": "www.example.com",
            "locale": "en_US",
            "pipeline": "Home-Show",
            "params": {
                "src": "campaign"
            },
            "apply-to-host-only-request-with-params": true
        }
    ],
    */

    /*
     * Legacy user-agent redirect with an unconditional fallback
     *
     * if-agent-contains matches User-Agent text case-insensitively
     * The first applicable rule wins
     * Each matching host action returns a permanent 301 response
     */
    /*
    "device.example.com": [
        {
            "if-agent-contains": ["iphone", "ipod", "android"],
            "host": "m.example.com"
        },
        {
            "if-agent-contains": ["blackberry"],
            "host": "legacy-mobile.example.com"
        },
        {
            "host": "www.example.com"
        }
    ],
    */
}
